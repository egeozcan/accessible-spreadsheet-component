{
  "name": "y11n-spreadsheet",
  "version": "1.4.0",
  "description": "Accessible spreadsheet web component built with Lit 3.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "spreadsheet",
    "accessible",
    "web-component",
    "lit",
    "aria",
    "a11y",
    "wai-aria",
    "grid"
  ],
  "author": "Ege Ozcan <egecan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeozcan/accessible-spreadsheet-component.git"
  },
  "homepage": "https://github.com/egeozcan/accessible-spreadsheet-component#readme",
  "bugs": {
    "url": "https://github.com/egeozcan/accessible-spreadsheet-component/issues"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/web-components": "^10.6.6",
    "@storybook/web-components-vite": "^10.6.6",
    "jsdom": "^31.0.0",
    "lit": "^3.3.3",
    "storybook": "^10.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
